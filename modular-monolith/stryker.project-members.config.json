{
    "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
    "testRunner": "command",
    "coverageAnalysis": "off",
    "concurrency": 2,
    "tempDirName": ".stryker-tmp/project-members",
    "reporters": ["clear-text", "html", "json"],
    "ignorePatterns": ["coverage", ".stryker-tmp", "reports"],
    "mutate": ["src/modules/project/internal/ProjectQueries.ts:135-227"],
    "commandRunner": {
        "command": "DB_PORT=5435 KAFKA_BROKERS=localhost:9094 REDIS_URL=redis://localhost:6380 bun test src/tests/e2e/project/project.member.add.test.ts src/tests/e2e/project/project.member.remove.test.ts --concurrency 1"
    },
    "thresholds": {
        "high": 80,
        "low": 70,
        "break": 0
    }
}
