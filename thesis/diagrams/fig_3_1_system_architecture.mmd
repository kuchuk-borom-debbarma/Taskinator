flowchart TD
    subgraph Client["Client Layer"]
        UI["React Frontend (TypeScript)\nTask Graph Visualization | Apollo Client | SSE Listener"]
    end

    subgraph API["API Layer"]
        GQL["GraphQL API Gateway\nMutation Resolvers | Subscription Bridge | Auth Middleware"]
    end

    subgraph Backend["Application Layer (Node.js Modular Monolith)"]
        SVC["Domain Services\n(Project, Task, Team, Member)"]
        RELAY["Outbox Relay\n(pg LISTEN/NOTIFY)"]
        CONS["Kafka Consumers\n(Aggregator | Reachability | RT Router)"]
    end

    subgraph Infra["Infrastructure Layer"]
        DB[("PostgreSQL\nPrimary Database")]
        KAFKA["Apache Kafka\nEvent Bus"]
        REDIS["Redis\nPub/Sub & Routing Table"]
    end

    UI <-->|"GraphQL Queries & Mutations"| GQL
    GQL <-->|"SSE Push (Real-time Updates)"| UI
    GQL --> SVC
    SVC -->|"Atomic wCTE Writes"| DB
    DB -->|"LISTEN/NOTIFY"| RELAY
    RELAY -->|"Publish Batch (partitioned by projectId)"| KAFKA
    KAFKA --> CONS
    CONS -->|"Delta Updates"| DB
    CONS -->|"SMEMBERS / PUBLISH"| REDIS
    REDIS -->|"Targeted Push"| GQL
