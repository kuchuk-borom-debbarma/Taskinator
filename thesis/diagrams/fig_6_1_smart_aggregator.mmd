flowchart TD
    Kafka["Apache Kafka Topic\n(100+ raw events per batch)"]

    subgraph Consumer["Smart Batch Aggregator — Single Consumer Transaction"]
        Claim["Step 1: Idempotency Claim\nINSERT INTO processed_event\n(event_id, consumer_group)\nON CONFLICT DO NOTHING RETURNING event_id\n\nOnly returned IDs are processed"]
        Sort["Step 2: Chronological Sort\nSort by event.timestamp ASC\nEnsures causal correctness\n(CREATE before UPDATE before DELETE)"]
        Fold["Step 3: Semantic Folding\nIn-memory reduction by (projectId, eventType)\n\nExample: 50× TASK_CREATED + 20× TASK_DELETED\n→ Net delta: +30"]
        Emit["Step 4: Emit Declarative Signal\nSingle atomic UPDATE per aggregate:\nUPDATE project SET task_count = task_count + 30"]
    end

    DB[("PostgreSQL\n(Denormalized counters)")]

    Kafka -->|"Batch consume"| Claim
    Claim --> Sort
    Sort --> Fold
    Fold --> Emit
    Emit -->|"Single SQL write\n(replaces 70 individual updates)"| DB
