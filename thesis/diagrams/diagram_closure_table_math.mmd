graph TD
    classDef ancestor fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px;
    classDef target fill:#fff3e0,stroke:#e65100,stroke-width:2px;
    classDef descendant fill:#e3f2fd,stroke:#1565c0,stroke-width:2px;
    classDef operation fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px,stroke-dasharray: 5 5;

    A1((A1)):::ancestor --> A((Task A)):::target
    A2((A2)):::ancestor --> A
    
    A -->|"CREATE LINK"| B((Task B)):::target
    
    B --> D1((D1)):::descendant
    B --> D2((D2)):::descendant
    
    CrossJoin["Cross-Join Operation:<br/>(A1, A2, A) x (B, D1, D2)"]:::operation
    
    A1 -.-> CrossJoin
    A2 -.-> CrossJoin
    A -.-> CrossJoin
    B -.-> CrossJoin
    D1 -.-> CrossJoin
    D2 -.-> CrossJoin
